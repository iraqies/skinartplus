{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skinart+",
  "version": "1.0.5",
  "identifier": "com.skinartplus.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Skinart+",
        "url": "index.html",
        "width": 1100,
        "height": 820,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "maximizable": true,
        "backgroundColor": "#0f172a",
        "visible": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      },
      "csp": "default-src 'self' customprotocol: asset:; img-src 'self' asset: http://asset.localhost https://mc-heads.net https://fonts.gstatic.com data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; script-src 'self'; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com;"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyM0E3Njk2NERFRDhCQzIKUldUQ2krMU5sblk2MGpoRmdCbXo3blFJR0IxZUwvemd2YVgzbm53YTdUdW9kVXd2N0xGM0dQaTcK",
      "endpoints": [
        "https://github.com/iraqies/skinartplus/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": {
      "../templates/**/*": "templates/",
      "../lib/*.png": "lib/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
